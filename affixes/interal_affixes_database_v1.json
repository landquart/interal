{
  "schema_version": "interal_affixes_database_v1",
  "status": "methodological_candidate_database",
  "scope": {
    "ru": "Очищенная методологическая база морфем-кандидатов Interal: префиксы, деривационные суффиксы, интерфиксы и связанные лексические комбинируемые формы. База предназначена для оценки международности, деривационной прозрачности и риска ложной морфемизации; она не является полным академическим перечнем аффиксов.",
    "en": "Clean methodological database of Interal morpheme candidates: prefixes, derivational suffixes, interfixes, and bound lexical combining forms. It supports internationality checks, derivational transparency, and false-positive risk assessment; it is not a complete academic affix inventory."
  },
  "languages": {
    "control": {
      "en": "English",
      "de": "German",
      "fr": "French",
      "es": "Spanish",
      "it": "Italian",
      "ru": "Russian",
      "el": "Greek"
    },
    "auxiliary": {
      "pl": "Polish",
      "sv": "Swedish",
      "ca": "Catalan",
      "oc": "Occitan",
      "ro": "Romanian"
    }
  },
  "types": {
    "prefix": "before the stem with stable derivational or semantic function",
    "suffix": "after the stem with derivational function",
    "postfix": "post-stem grammatical/clitic-like element; usually non-candidate for Interal",
    "interfix": "linking element between stems, not a derivational suffix",
    "combining_form": "bound lexical morpheme used in international compounds; not an ordinary suffix"
  },
  "originTypes": [
    "borrowed_international",
    "inherited_indoeuropean",
    "mixed",
    "uncertain",
    "non_candidate"
  ],
  "recommended_scoring": {
    "internationalEvidence": 0.35,
    "semanticStability": 0.25,
    "productivity": 0.2,
    "formalStability": 0.1,
    "interalCompatibility": 0.1
  },
  "methodology": {
    "ru": [
      "Не выделять аффикс только по совпадению букв.",
      "Связанные греко-латинские элементы вроде -логия, -скопия, -кратия хранятся как combining_form, а не suffix.",
      "Пустые массивы означают отсутствие полезной формы в данном языке."
    ],
    "en": [
      "Do not segment an affix from letter overlap alone.",
      "Bound Greek-Latin elements such as -logy, -scopy, and -cracy are stored as combining_form, not suffix.",
      "Empty arrays mean no useful form is recorded for that language."
    ]
  },
