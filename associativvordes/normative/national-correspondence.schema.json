{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interal.vercel.app/spec/national-correspondence/1.0.0",
  "type": "object",
  "properties": {
    "form": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "en",
            "de",
            "fr",
            "es",
            "it",
            "ru"
          ]
        },
        "lemma_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "lexeme_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sense_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "context_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "family_id",
        "element_id",
        "language",
        "lemma_id",
        "lexeme_id",
        "sense_id",
        "context_id"
      ],
      "additionalProperties": false
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "from_sense": {
            "type": "string",
            "minLength": 1
          },
          "to_sense": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "const": "directed"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "from",
          "to",
          "from_sense",
          "to_sense",
          "direction",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "form",
    "scope",
    "evidence_ids",
    "steps"
  ],
  "additionalProperties": false
}
