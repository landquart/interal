{
  "schema_version": 1,
  "automatic_merge_allowlist": [
    "direct_allomorph",
    "direct_descendant",
    "borrowed_form",
    "inherited_form"
  ],
  "review_only": [
    "compound_component",
    "affix_component",
    "distant_ancestor",
    "proto_relation",
    "homonym",
    "uncertain"
  ],
  "unknown_relation": {
    "relation_type": "uncertain",
    "merge_allowed": false,
    "review_required": true
  },
  "malformed_expansion": {
    "relation_type": "uncertain",
    "merge_allowed": false,
    "review_required": true
  },
  "etymon_expansion": {
    "relation_type": "distant_ancestor",
    "merge_allowed": false,
    "review_required": true
  },
  "seed_absorption": "exact_node_claim_only",
  "canonical_policy": "quality_score_v1",
  "associative_membership": {
    "definition": "The entire requested lexical or prepositional element must occur in the word under existing search normalization, and etymology must support that component. Historical relationship alone does not substitute a different spelling.",
    "component_membership": "review_explicitly",
    "whole_lemma_union_from_component": false,
    "positive_controls": {
      "nat": [
        "nation",
        "natural",
        "natalism"
      ],
      "loc": [
        "location",
        "local",
        "locomotive"
      ],
      "inter": [
        "international",
        "interval",
        "internet"
      ]
    },
    "substring_matching": "necessary_but_insufficient",
    "exact_fragment_required": true,
    "negative_controls": {
      "nat": [
        "naive",
        "naïve",
        "NATO"
      ],
      "loc": [
        "lieu",
        "lieutenant",
        "locution"
      ],
      "inter": [
        "interment",
        "teleprinter",
        "midwinter"
      ]
    },
    "family_size_cap": null
  }
}
