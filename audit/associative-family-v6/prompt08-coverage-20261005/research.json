  "source_facts": [
    {
      "language": "en",
      "url": "https://www.merriam-webster.com/dictionary/atom",
      "retrieval_ref": "turn10view0",
      "accessed": "2026-10-05",
      "finding": "English atom is a noun for the chemical element unit, the ancient indivisible particle and a figurative tiny amount. Its history goes through Middle English and Latin atomus to Greek atomos. The entry uses atoms as the plural. No particular frequency token, processor or product name is classified."
    },
    {
      "language": "de",
      "url": "https://www.duden.de/rechtschreibung/Atom",
      "retrieval_ref": "turn11view0",
      "accessed": "2026-10-05",
      "finding": "German Atom has the chemical element sense and a tiny-particle figurative sense. Duden gives Latin atomus from Greek atomos, genitive Atoms and plural Atome. This is a borrowed lexical row, not a universal Latin ending deletion."
    },
    {
      "language": "de",
      "url": "https://www.duden.de/rechtschreibung/Atombombe",
      "retrieval_ref": "turn11view1",
      "accessed": "2026-10-05",
      "finding": "Duden defines Atombombe as a nuclear explosive and displays the Atom|bom|be boundary. The finite atom component belongs to the independently established German Atom row; the whole compound retains its own identity."
    },
    {
      "language": "ru",
      "url": "https://gramota.ru/poisk?dicts%5B%5D=42&mode=slovari&query=%D0%B0%D1%82%D0%BE%D0%BC",
      "retrieval_ref": "turn13view0",
      "accessed": "2026-10-05",
      "finding": "The editorial Russian dictionary identifies атом as a masculine noun from Greek atomos, with chemical-particle, figurative structural-unit and nuclear-energy senses. These are documented developments of the same borrowed row; the precise intermediate borrowing language is not settled by this entry."
    },
    {
      "language": "it",
      "url": "https://www.treccani.it/vocabolario/attimo/",
      "retrieval_ref": "turn12view0",
      "accessed": "2026-10-05",
      "finding": "Treccani treats attimo as a popular variant of atomo and connects the instant meaning with a Late Latin expression modelled on Greek. Direct history alone does not establish recognizable atom in modern attimo; this branch is withheld from the atom frame, rather than rejecting its history."
    },
    {
      "language": "en",
      "url": "https://www.merriam-webster.com/dictionary/anatomy",
      "retrieval_ref": "turn14view0",
      "accessed": "2026-10-05",
      "finding": "Anatomy is a separate lexical history and needs its own documented boundary. Shared ancient cutting vocabulary or an accidental atom spelling sequence cannot authorize atom membership."
    },
    {
      "language": "en",
      "url": "https://www.merriam-webster.com/dictionary/splinter",
      "retrieval_ref": "turn14view2",
      "accessed": "2026-10-05",
      "finding": "The editorial entry supports splinter as a real noun and verb with Middle English/Middle Dutch history. Its absence from v5 memberships is a retrieval gap, not evidence of lexical invalidity or an inter family relation."
    },
    {
      "language": "de",
      "url": "https://www.duden.de/rechtschreibung/Tennis",
      "retrieval_ref": "turn14view3",
      "accessed": "2026-10-05",
      "finding": "German Tennis is supported as the ball game, borrowed through English. The entry documents French tenez and Latin tenere as history; that is not authorization to merge tennis with a distant ten family."
    },
    {
      "language": "de",
      "url": "https://www.duden.de/rechtschreibung/Profi",
      "retrieval_ref": "turn14view4",
      "accessed": "2026-10-05",
      "finding": "Profi is independently attested for a professional, including a professional athlete, and is a shortening of Professional. Tennis-profi is a promising finite component question in the zero-v5 frame, not a promoted whole row."
    }
