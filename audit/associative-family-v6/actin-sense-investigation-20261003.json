  "findings": [
    {
      "sense": "cellular_protein",
      "finding": "Merriam-Webster separately records the protein noun, with tentative origin from act or activate plus -in. It does not justify automatic Greek-ray exclusion. Actin, f-actin and actin-binding remain investigated uncertain until the family-specific relation and compound boundaries have been adjudicated."
    },
    {
      "sense": "Greek_ray_combining_form",
      "finding": "Merriam-Webster records actin-/actini-/actino- from Greek aktis/aktin-, distinct from the protein noun. The actinic article explicitly confirms Greek ray/beam origin. No shared-spelling equivalence is approved."
    },
    {
      "sense": "unknown_actina",
      "finding": "actina cannot be assigned to either branch from spelling alone."
    }
