def entry(form, meaning):
    return {"form": form, "meaning_ru": meaning}

def ex(
    id_, number, zone, logical, international, chain=None,
    chain_type=None, source="catalog_table", notes=None, source_mentions=None
):
    return {
        "id": id_,
        "number": number,
        "source": source,
        "source_mentions": source_mentions or [source],
        "logical_entries": logical,
        "international_entries": international,
        "zone_id": zone,
        "zone_ru": zone_definitions[zone]["label_ru"],
        "scores": zone_definitions[zone]["prototype_scores"],
        "scores_note": "Prototype P/R/C/E values inferred from the document's zone label. They may be manually corrected for borderline cases.",
        "chain_type": chain_type,
        "draft_explanatory_chain_ru": chain or [],
        "notes_ru": notes or ""
    }

